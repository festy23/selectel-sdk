          "content_type": {
            "type": "string"
          },
          "unauth_download_external_url": {
            "type": "string",
            "format": "url"
          },
          "height": {
            "type": "integer",
            "format": "int32"
          },
          "public_download_url": {
            "type": "string",
            "format": "url"
          },
          "user_id": {
            "type": "integer",
            "format": "int32"
          },
          "private_download_url": {
            "type": "string",
            "format": "url"
          },
          "size": {
            "type": "integer",
            "format": "int32"
          }
