  "info": {
    "title": "Tickets Attachments API",
    "version": "v1",
    "description": "Managing attachments for Control panel tickets"
  },
  "servers": [
    {
      "url": "https://api.selectel.ru/files"
    }
  ],
  "security": [
    {
      "static_token": []
    }
  ],
  "tags": [
    {
      "name": "Files",
      "description": "Ticket files"
    }
  ],
  "openapi": "3.0.2",
